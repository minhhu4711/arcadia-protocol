# Public values only. Vite ships every VITE_ variable to the browser.
# Never put private keys or API secrets in a VITE_ variable.

# Deployed ARCADIA contracts on Arc Testnet
VITE_ARCADIA_FACTORY=
VITE_ARCADIA_VAULT=
# Block of deployment; history scanning starts here
VITE_ARCADIA_DEPLOY_BLOCK=

# --- Operator-only (used by contracts/script/DeployArcadia.s.sol, never by the browser) ---
# ADMIN_ADDRESS=
# USDC_ADDRESS=
# ARC_TESTNET_RPC_URL=
# Prefer a Foundry keystore (cast wallet import) over a plain env private key.
